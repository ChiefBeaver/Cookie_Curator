{
  "manifest_version": 2,
  "name": "Cookie Curator",
  "version": "0.7.0",
  "description": "Cookies und lokalen Speicher pro Seite steuern: Login- und Consent-Daten behalten, den Rest löschen, blockieren oder archivieren.",
  "author": "ChiefBeaver",
  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-curator@chief-beaver.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "alarms",
    "browsingData",
    "scripting",
    "contextualIdentities",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/i18n.js",
      "lib/core.js",
      "lib/pagefns.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    },
    "default_title": "Cookie Curator"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
